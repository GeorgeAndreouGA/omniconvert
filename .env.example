
#
#   ALLOWED_IPS=192.168.1.0/24,203.0.113.7,2001:db8::/32
ALLOWED_IPS=all

# The port on 127.0.0.1 that your host nginx proxies to (see deploy/host-nginx-subpath.conf).
HOST_PORT=8090

# ---- Access (optional) ------------------------------------------------------------------------

# Require a token as well as an allowed IP. Empty means off. Generate one with: openssl rand -hex 32
API_TOKEN=


BASE_PATH=/convert/

# The private Docker network between the host and the gateway. The gateway trusts X-Real-IP only
# from EDGE_GATEWAY. Change both if this range clashes with one of yours.
EDGE_SUBNET=172.31.90.0/24
EDGE_GATEWAY=172.31.90.1

# ---- Jobs -------------------------------------------------------------------------------------

MAX_UPLOAD_BYTES=1073741824        # 1 GiB. Keep client_max_body_size in the nginx snippet in step.
MAX_OUTPUT_BYTES=1610612736        # 1.5 GiB, for any single result
JOB_TIMEOUT_SECONDS=1800           # 30 minutes per job. Raise it for long video on a Raspberry Pi.
RETENTION_MINUTES=10               # a result nobody downloads is deleted after this. Downloading deletes it at once.
MAX_QUEUE=20                       # uploads waiting in line; more get a "busy" answer
MAX_JOBS_PER_IP=10                 # unfinished jobs per client address
RATE_LIMIT_PER_MINUTE=600          # requests per client address; the page polls about once a second



JOB_STORE_SIZE=2g                  # waiting uploads and finished results, in the gateway
GATEWAY_MEMORY=2300M               # at least JOB_STORE_SIZE + 128M
GATEWAY_CPUS=0.5
GATEWAY_PIDS=64

WORKER_WORK_SIZE=3g                # the job in progress: its input, temporary files and result
WORKER_TMP_SIZE=256m               # /tmp, for libraries that ignore TMPDIR
WORKER_MEMORY=4G                   # at least both of the above + 128M. The rest is for the converter itself.
WORKER_CPUS=3.0
WORKER_PIDS=512
WORKER_THREADS=3                   # threads a converter may use; keep it near WORKER_CPUS


LOG_CONVERTER_OUTPUT=0
